# ============================================
#  Author App — 环境变量配置
# ============================================
#
#  📖 使用教程:
#
#  1. 复制本文件并重命名:
#     将 .env.example 复制一份，命名为 .env.local
#     （Windows: 复制粘贴后重命名; 命令行: copy .env.example .env.local）
#
#  2. 编辑 .env.local:
#     取消你需要的配置项的注释（删掉行首的 #），填入你自己的值
#     例如想用智谱AI，只需修改 API_KEY 那一行
#
#  3. 启动应用:
#     配置会自动生效，无需其他操作
#
#  ⚠️ 注意事项:
#     - 不要直接编辑 .env.example，它只是模板
#     - .env.local 已被 .gitignore 忽略，不会泄露你的 Key
#     - 如果同时在应用内 ⚙️ 设置了配置，应用内设置优先
#     - 只需配置你使用的那一个供应商，不需要全部填写
#
# ============================================


# ==================== 服务端口 ====================

# 自定义服务端口（默认 3000，被占用时自动递增查找）
# PORT=3000


# ==================== OpenAI 兼容 API ====================
# 适用于: 智谱AI / DeepSeek / SiliconFlow / 火山引擎 / Moonshot 等
# 所有兼容 OpenAI /v1/chat/completions 格式的供应商均可使用

# API_KEY=
# API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# API_MODEL=glm-4.7-flash

# 各供应商 Base URL 参考:
#   智谱AI:       https://open.bigmodel.cn/api/paas/v4
#   DeepSeek:     https://api.deepseek.com
#   OpenAI:       https://api.openai.com/v1
#   SiliconFlow:  https://api.siliconflow.cn/v1
#   火山引擎:     https://ark.cn-beijing.volces.com/api/v3
#   Moonshot:     https://api.moonshot.cn/v1

# 各供应商推荐模型:
#   智谱AI:       glm-4.7-flash (免费) / glm-5.3 / glm-5.3-flash / glm-5.2
#   DeepSeek:     deepseek-flash / deepseek-v4-pro
#   SiliconFlow:  deepseek-ai/DeepSeek-V4.1-Flash / zai-org/GLM-5.3
#   Moonshot:     kimi-k3 / kimi-k2.6

# 兼容旧版变量名（优先使用 API_KEY）
# ZHIPU_API_KEY=


# ==================== Google Gemini ====================
# 官网: https://aistudio.google.com

# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-3.8-flash

# 可选模型: gemini-4-argon / gemini-3.6-flash / gemini-3.5-flash-lite / gemini-3.1-flash-lite
# OpenAI 兼容模式也可用，将 Base URL 改为:
#   https://generativelanguage.googleapis.com/v1beta/openai
# 然后使用上方 API_KEY/API_BASE_URL/API_MODEL 配置即可


# ==================== Claude (Anthropic) ====================
# 官网: https://console.anthropic.com

# CLAUDE_API_KEY=
# CLAUDE_BASE_URL=https://api.anthropic.com
# CLAUDE_MODEL=claude-opus-5-5

# 可选模型: claude-sonnet-5-5 / claude-haiku-5-5 / claude-fable-5-1


# ==================== OpenAI Responses API ====================
# 适用于 OpenAI /v1/responses 格式

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-6-luna

# 可选模型: gpt-6-astra / gpt-6.1-sol / gpt-5.6-sol


# ==================== 快速配置示例 ====================
#
# 🔹 示例1: 用智谱AI免费模型（最简配置，只需一行）
#    API_KEY=
#    （把你的智谱 Key 填到等号后）
#
# 🔹 示例2: 用DeepSeek
#    API_KEY=
#    （把你的 DeepSeek Key 填到等号后）
#    API_BASE_URL=https://api.deepseek.com
#    API_MODEL=deepseek-flash
#
# 🔹 示例3: 用Gemini
#    GEMINI_API_KEY=
#    （把你的 Gemini Key 填到等号后）
#
# 🔹 示例4: 用Claude
#    CLAUDE_API_KEY=
#    （把你的 Claude Key 填到等号后）
#
# 🔹 示例5: 自定义端口 + 智谱AI
#    PORT=8080
#    API_KEY=
#    （把你的智谱 Key 填到等号后）


# ============================================
#  源码部署在线更新（可选）
# ============================================
# 源码部署若要从界面执行 git pull / npm install / build，必须设置一个长随机令牌；
# 未设置时在线更新接口默认关闭。点击在线更新时，界面会要求输入这个令牌。
# AUTHOR_UPDATE_TOKEN=


# ============================================
#  自建云同步服务器（Author Cloud）
# ============================================
# 账号登录 + 作品云同步连接的后端地址。不填则登录时提示"未配置同步服务器"。
#   - 自托管：填你自己部署的后端地址，例如 https://your-domain.com 或 https://api.your-domain.com
#   - 本地联调：http://localhost:8788（需先起本地内存版后端 + CORS 代理）
# 说明：这是"作品图谱同步"用的后端；API 密钥、聊天记录等隐私数据始终只留在本地，不参与同步。

# NEXT_PUBLIC_AUTHOR_CLOUD_URL=


# ============================================
#  服务端文件存储（仅可信单用户自托管，可选）
# ============================================
# 默认关闭。公开或多人部署不得启用；浏览器本地存储、WebDAV 和账号云同步不依赖此功能。
# 必须使用项目目录以外的绝对路径，避免数据进入源码或构建产物。
# AUTHOR_ENABLE_FILE_STORAGE=1
# DATA_DIR=/absolute/path/to/author-data
# 仅在管理员手动恢复旧目录时临时启用，完成后立即关闭：
# AUTHOR_ALLOW_ORPHAN_STORAGE_ADOPTION=1


# ============================================
#  允许连接本机 / 局域网地址（仅可信自部署，可选）
# ============================================
# 默认关闭：服务端不代理访问 localhost、127.0.0.1、192.168.x.x 等地址，防止公开实例被借来探测内网。
# 在 NAS / 家用服务器上用 Docker 部署、需要连 Ollama、LM Studio 等本地模型或内网 WebDAV 时再打开。
# 在 API 配置里填写 HTTP 代理地址也需要打开此项，否则会被拒绝。
# 开启后，任何能打开此页面的人都能让服务器访问你的局域网，公网部署不要开启。官网构建会忽略此项。
# 注意：容器里的 localhost 指容器自己，本地模型地址请填模型所在机器的局域网 IP，详见 LOCAL_MODELS.md。
# AUTHOR_ALLOW_PRIVATE_NETWORK=1


# ============================================
#  公网部署选项（可选）
# ============================================
# 可信入口：Caddy 与 Author 配置相同的随机密钥（至少 32 字符），入口覆盖
# X-Author-Proxy-Token / X-Author-Client-IP。不要把这个密钥发给浏览器。
# 未配置时，客户端转发地址头不会被采信，请求共用限流桶。
# AUTHOR_PROXY_TOKEN=
# Limits and ingress setup: API_RESOURCE_LIMITS.md
# 子路径部署前缀：把应用挂在域名子路径下时设置（如反向代理到 https://example.com/app 时设为 /app）。
# 根路径部署（默认）无需设置。
# NEXT_PUBLIC_BASE_PATH=

# 网站备案信息（仅中国大陆公网部署需要）：
# 若你把 Author 部署到中国大陆的公网域名，按规定需在页面展示你自己的 ICP 备案号。
# 设置后页面底部与登录弹窗会显示备案信息；不设置则页面不显示任何备案内容。
# NEXT_PUBLIC_ICP_BEIAN=
# 备案号跳转链接（默认工信部 https://beian.miit.gov.cn/）
# NEXT_PUBLIC_ICP_BEIAN_URL=
# 公安联网备案号与其跳转链接（可选）
# ⚠️ 值里含 # 时必须整体加双引号（.env 里未加引号的 # 起注释作用，会把后半段截掉），
#    如 NEXT_PUBLIC_POLICE_BEIAN_URL="https://beian.mps.gov.cn/#/query/webSearch?code=xxxxxxxx"
# NEXT_PUBLIC_POLICE_BEIAN=
# NEXT_PUBLIC_POLICE_BEIAN_URL=

# 页脚版权署名（显示为「© 2026 署名」；不设置则不显示该行。可含品牌+公司，如 "Author · 某某公司"）
# NEXT_PUBLIC_COPYRIGHT_NAME=
